{
    "name": "dvdoug/boxpacker",
    "description": "3D bin packing with weight: cartonize orders into parcels, or fill a single container / pallet and leave leftover cargo unpacked",
    "keywords": [
        "packing",
        "binpacking",
        "bin packing",
        "knapsack",
        "box",
        "boxpacking",
        "parcel",
        "parcelpacking",
        "shipping",
        "packaging",
        "boxes",
        "container",
        "3d bin packing",
        "cartonization",
        "ecommerce",
        "logistics",
        "pallet",
        "container loading"
    ],
    "type": "library",
    "homepage": "https://boxpacker.io/",
    "authors": [
        {
            "name": "Doug Wright",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/log": "^1.0||^2.0||^3.0"
    },
    "require-dev": {
        "behat/behat": "^3.27",
        "dvdoug/behat-code-coverage": "^5.3",
        "friendsofphp/php-cs-fixer": "^3.93.1",
        "monolog/monolog": "^3.9",
        "phpunit/phpunit": "^11.5.44||^12.4.4"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "bin-compat" : "full",
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "DVDoug\\BoxPacker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DVDoug\\BoxPacker\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.*",
            "/*.dist",
            "/*.dist.php",
            "/*.md",
            "/bin",
            "/docs",
            "/features",
            "/tests",
            "/visualiser"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
