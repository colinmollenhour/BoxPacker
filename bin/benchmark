#!/usr/bin/env php
<?php

/**
 * Box packing (3D bin packing, knapsack problem).
 *
 * @author Doug Wright
 */
declare(strict_types=1);

use DVDoug\BoxPacker\Benchmark\BenchmarkRunner;
use DVDoug\BoxPacker\Benchmark\InstanceLoader;
use DVDoug\BoxPacker\Benchmark\Strategies;

require __DIR__ . '/../vendor/autoload.php';

ini_set('memory_limit', '-1');

$usage = <<<'USAGE'
    Usage: bin/benchmark [options]

      --strategy=NAME     strategy to run (default: legacy); --list to see all
      --datasets=SPEC     comma list of datasets or groups (default: published)
                          groups: ecommerce, container, extreme, bookshop, published, all (published + bookshop), angled; ranges like br1-7
      --limit=N           only the first N instances of each dataset (0 = all)
      --jobs=N            parallel worker processes (default: 4)
      --opt=KEY=VALUE     strategy option, repeatable (e.g. --opt=width=8 --opt=time=2)
      --save=PATH         write full results (summary + per-instance rows) as JSON
      --compare=PATH      compare against a previously saved result (over the instances both runs have)
      --rows              print one line per instance
      --csv=PATH          write "test name,utilisation" lines for single-container datasets, or "test name,containers"
                          for ivancic alone (the format of tests/data/published-expected*.csv and ivancic-expected*.csv)
      --list              list strategies

    Exits 1 if any instance fails with an error or produces an invalid packing, 2 on a usage or output error.

    USAGE;

$opts = getopt('', ['strategy:', 'datasets:', 'limit:', 'jobs:', 'opt:', 'save:', 'compare:', 'rows', 'csv:', 'list', 'worker', 'shard:', 'help']);

if (isset($opts['help'])) {
    echo $usage;
    exit(0);
}
if (isset($opts['list'])) {
    foreach (Strategies::describe() as $name => $description) {
        printf("%-16s %s\n", $name, $description);
    }
    exit(0);
}

$strategy = $opts['strategy'] ?? 'legacy';
$datasetSpec = $opts['datasets'] ?? 'published';
$datasets = InstanceLoader::expandDatasetNames($datasetSpec);
$limit = (int) ($opts['limit'] ?? 0);
$jobs = max(1, (int) ($opts['jobs'] ?? 4));
$strategyOptions = [];
foreach ((array) ($opts['opt'] ?? []) as $kv) {
    [$k, $v] = array_pad(explode('=', $kv, 2), 2, '1');
    $strategyOptions[$k] = $v;
}

try {
    Strategies::validateOptions($strategy, $strategyOptions);
    $kinds = [];
    foreach ($datasets as $dataset) {
        $kinds[$dataset] = InstanceLoader::kind($dataset);
    }
} catch (InvalidArgumentException $e) {
    BenchmarkRunner::stderr($e->getMessage());
    exit(2);
}
$multiDatasets = array_keys($kinds, 'multi', true);
if ($multiDatasets !== [] && !Strategies::supportsMulti($strategy)) {
    BenchmarkRunner::stderr("Strategy {$strategy} is single-container only; drop the multi-container datasets: " . implode(', ', $multiDatasets));
    exit(2);
}
if (isset($opts['csv']) && $multiDatasets !== [] && $datasets !== ['ivancic']) {
    BenchmarkRunner::stderr('--csv writes one value per instance, so it takes either single-container datasets or ivancic alone. The bookshop baselines (and the other PHPUnit baselines) are written to tests/data/*-lastrun*.csv by the PHPUnit suites instead.');
    exit(2);
}

// The workers run with assertions off, so that an invalid packing is counted by PackingValidator rather than
// thrown; do the same in-process.
if ((int) ini_get('zend.assertions') === 1) {
    ini_set('zend.assertions', '0');
}

$runner = new BenchmarkRunner($strategy, $strategyOptions);

if (isset($opts['worker'])) {
    [$shard, $shards] = array_map('intval', explode('/', $opts['shard'] ?? '0/1'));
    echo json_encode($runner->runShard($datasets, $limit, $shard, $shards), JSON_THROW_ON_ERROR);
    exit(0);
}

$baseline = null;
if (isset($opts['compare'])) {
    try {
        $baseline = BenchmarkRunner::loadResult($opts['compare']);
    } catch (RuntimeException|JsonException $e) {
        BenchmarkRunner::stderr("Cannot load {$opts['compare']}: {$e->getMessage()}");
        exit(2);
    }
}

$workerArgs = ["--strategy={$strategy}", "--datasets={$datasetSpec}", "--limit={$limit}"];
foreach ($strategyOptions as $k => $v) {
    $workerArgs[] = "--opt={$k}={$v}";
}

$wallStart = hrtime(true);
$rows = $jobs === 1
    ? BenchmarkRunner::sortRows($runner->runShard($datasets, $limit, 0, 1), $datasets)
    : $runner->runParallel(__FILE__, $datasets, $limit, $jobs, $workerArgs);
$wall = (hrtime(true) - $wallStart) / 1e9;

$summary = BenchmarkRunner::summarise($rows);

if (isset($opts['rows'])) {
    foreach ($rows as $row) {
        if (isset($row['error'])) {
            printf("%-12s %-8s ERROR %s\n", $row['dataset'], $row['id'], $row['error']);
        } elseif ($row['kind'] === 'single') {
            printf("%-12s %-8s util %5.1f%% packed %d/%d %.3fs\n", $row['dataset'], $row['id'], $row['util'], $row['packed'], $row['items'], $row['time']);
        } else {
            printf("%-12s %-34s boxes %d lb %d vol %d packed %d/%d %.3fs\n", $row['dataset'], $row['id'], $row['boxes'], $row['lb'], $row['boxVolume'], $row['packed'], $row['items'], $row['time']);
        }
    }
}

$optionText = $strategyOptions ? ' ' . json_encode($strategyOptions) : '';
$title = "strategy {$strategy}{$optionText}, wall {$wall}s, jobs {$jobs}";
if ($baseline) {
    [$matchedRows, $matchedBaselineRows, $onlyCurrent, $onlyBaseline] = BenchmarkRunner::intersect($rows, $baseline['rows']);
    echo BenchmarkRunner::formatSummary($summary, BenchmarkRunner::summarise($matchedBaselineRows), $title, BenchmarkRunner::summarise($matchedRows));
    if ($onlyCurrent > 0 || $onlyBaseline > 0) {
        printf("baseline compared on the %d instances in both runs (%d only in this run, %d only in the baseline)\n", count($matchedRows), $onlyCurrent, $onlyBaseline);
    }
    echo BenchmarkRunner::formatWinLoss($rows, $baseline['rows']);
} else {
    echo BenchmarkRunner::formatSummary($summary, title: $title);
}

foreach ($rows as $row) {
    if (isset($row['error'])) {
        BenchmarkRunner::stderr("error in {$row['dataset']} {$row['id']}: {$row['error']}");
    }
}

$status = BenchmarkRunner::hasFailures($rows) ? 1 : 0;

if (isset($opts['save'])) {
    try {
        BenchmarkRunner::save($opts['save'], [
            'strategy' => $strategy,
            'options' => $strategyOptions,
            'datasets' => $datasets,
            'limit' => $limit,
            'php' => PHP_VERSION,
            'wall' => $wall,
            'summary' => $summary,
            'rows' => $rows,
        ]);
    } catch (RuntimeException $e) {
        BenchmarkRunner::stderr($e->getMessage());
        exit(2);
    }
    echo "saved {$opts['save']}\n";
}

if (isset($opts['csv'])) {
    if ($status !== 0) {
        BenchmarkRunner::stderr("Not writing {$opts['csv']}: some instances failed or produced invalid packings");
        exit($status);
    }
    $csv = '';
    foreach ($rows as $row) {
        $csv .= InstanceLoader::testName($row['dataset'], $row['id']) . ',' . ($row['kind'] === 'single' ? sprintf('%.1f', $row['util']) : $row['boxes']) . "\n";
    }
    try {
        BenchmarkRunner::writeFile($opts['csv'], $csv);
    } catch (RuntimeException $e) {
        BenchmarkRunner::stderr($e->getMessage());
        exit(2);
    }
    echo "wrote {$opts['csv']}\n";
}

exit($status);
